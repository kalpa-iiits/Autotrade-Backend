# SQLite for now; later e.g. postgresql+asyncpg://user:pass@host/autotrade
AUTOTRADE_DATABASE_URL=sqlite+aiosqlite:///./autotrade.db
# App login users live in the database: python -m app.auth.users create <username>
# Long random string; keeps logins valid across restarts. e.g.
# python -c "import secrets; print(secrets.token_urlsafe(32))"
AUTOTRADE_SESSION_SECRET=
# true when served over HTTPS
AUTOTRADE_SECURE_COOKIES=false
# Optional token for scripts/bots; leave empty to allow browser login only.
AUTOTRADE_API_TOKEN=
AUTOTRADE_BROKER=paper
AUTOTRADE_PAPER_STARTING_CASH=1000000
AUTOTRADE_TICK_INTERVAL=1.0

# Set AUTOTRADE_BROKER=fyers or zerodha to place REAL orders on that account.
AUTOTRADE_FYERS_CLIENT_ID=
AUTOTRADE_FYERS_SECRET_KEY=
# Must match the redirect URL registered on your Fyers app.
AUTOTRADE_FYERS_REDIRECT_URI=http://127.0.0.1:8000/auth/fyers/callback
AUTOTRADE_FYERS_PRODUCT_TYPE=INTRADAY

AUTOTRADE_ZERODHA_API_KEY=
AUTOTRADE_ZERODHA_API_SECRET=
AUTOTRADE_ZERODHA_PRODUCT=MIS

# Lets strategies in "live" mode place REAL orders. Keep false until you've dry-run them.
AUTOTRADE_STRATEGIES_LIVE=false

# A separate frontend on another origin (not needed when it proxies /api through its dev server):
# AUTOTRADE_CORS_ORIGINS=["http://localhost:5173"]
# Where the browser returns after a broker login:
# AUTOTRADE_FRONTEND_URL=http://localhost:5173/settings
