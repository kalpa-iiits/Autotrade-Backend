# SQLite for now; later e.g. postgresql+asyncpg://user:pass@host/autotrade
AUTOTRADE_DATABASE_URL=sqlite+aiosqlite:///./autotrade.db
# App login users live in the database: python -m app.auth.users create <username>
# Long random string; keeps logins valid across restarts. e.g.
# python -c "import secrets; print(secrets.token_urlsafe(32))"
AUTOTRADE_SESSION_SECRET=
# true when served over HTTPS
AUTOTRADE_SECURE_COOKIES=false
# Let anyone create a user with POST /api/auth/signup (otherwise: python -m app.auth.users create).
AUTOTRADE_ALLOW_SIGNUP=false

# Encrypts every user's broker credentials and access tokens in the database. Required for
# Fyers/Zerodha accounts. Generate: python -m app.accounts.vault generate-key
# Keep it out of the database and its backups.
AUTOTRADE_CREDENTIALS_KEY=
# Old keys still accepted while `python -m app.accounts.vault rotate` re-encrypts (JSON list).
# AUTOTRADE_CREDENTIALS_OLD_KEYS=[]
AUTOTRADE_MAX_ACCOUNTS_PER_USER=10

# Users add their broker accounts (and paste their own Fyers / Kite app credentials) in the app.
# Register these redirect URLs on each Fyers app / Kite console app (same URL for every account):
AUTOTRADE_FYERS_REDIRECT_URI=http://127.0.0.1:8000/auth/fyers/callback
#   Zerodha: http://127.0.0.1:8000/auth/zerodha/callback
AUTOTRADE_PAPER_STARTING_CASH=1000000
AUTOTRADE_TICK_INTERVAL=1.0

# Run one server process only; it holds this lock (default: next to the SQLite file).
# AUTOTRADE_LOCK_FILE=
# Order placements + cancels per second sent to each account's broker.
AUTOTRADE_BROKER_ORDERS_PER_SECOND=8
# Seconds between order-book checks against our records (0 = only on reconnect).
AUTOTRADE_RESYNC_INTERVAL=60

# Lets strategies in "live" mode place REAL orders. Keep false until you've dry-run them.
AUTOTRADE_STRATEGIES_LIVE=false

# A separate frontend on another origin (not needed when it proxies /api through its dev server):
# AUTOTRADE_CORS_ORIGINS=["http://localhost:5173"]
# Where the browser returns after a broker login:
# AUTOTRADE_FRONTEND_URL=http://localhost:5173/settings
